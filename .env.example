# Optional admin env (NEXT_PUBLIC_* only — never secrets)

# API the admin talks to (staging vs prod — drives the always-on env banner)
# NEXT_PUBLIC_API_BASE_URL=https://api-staging.example.com

# Soft MFA nag in UI (enforcement is backend ADMIN_MFA_REQUIRED)
# NEXT_PUBLIC_ADMIN_MFA_NOTICE=true

# Allow /register in this build (prod must stay false — admins are invited)
# NEXT_PUBLIC_ADMIN_REGISTER_ENABLED=false

# Google GIS on the login page (same web OAuth client as www). Add this admin origin in Google Cloud.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Web preview link from CMS hub
# NEXT_PUBLIC_WEB_APP_URL=https://www.netqwix.com

# Observability deep links (User 360 / call diagnostics) — org slugs only
# NEXT_PUBLIC_SENTRY_ORG=your-org
# NEXT_PUBLIC_SENTRY_PROJECT=123
# NEXT_PUBLIC_LOGROCKET_APP_ID=org/app
